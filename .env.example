# Copy to .env and adjust if your ports differ:  cp .env.example .env
#
# Every broker address, port, topic name and group id lives here and is read by
# common/config.py (added in phase 2). Nothing in producer/, consumer/ or tools/
# is allowed to hardcode these values.

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Schema Registry ---
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- Topics ---
ORDERS_TOPIC=orders
DLQ_TOPIC=orders.DLQ

# --- Consumer ---
CONSUMER_GROUP_ID=orders-consumer-group

# --- Logging ---
LOG_LEVEL=INFO
